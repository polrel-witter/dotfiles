{
  // ==========================================================================
  //  %APPDATA%\Code\User\settings.json
  //  Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)"
  // ==========================================================================

  // --- Neovim backend -------------------------------------------------------
  // Affinity puts vscode-neovim in its own extension host process. Without it
  // you get input lag whenever another extension blocks the shared host.
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1
  },
  "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",
  "vscode-neovim.neovimInitVimPaths.win32": "C:\\Users\\CHANGE_ME\\AppData\\Local\\nvim\\init.vim",
  // Set to true only if you run Neovim inside WSL rather than natively:
  "vscode-neovim.useWSL": false,

  // --- Editor ---------------------------------------------------------------
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 8,
  "editor.scrollBeyondLastLine": false,
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.renderWhitespace": "boundary",
  "editor.stickyScroll.enabled": false,
  "editor.minimap.enabled": false,
  "editor.cursorBlinking": "solid",
  "editor.cursorSmoothCaretAnimation": "off",
  "editor.smoothScrolling": false,
  "workbench.list.smoothScrolling": false,
  "editor.find.seedSearchStringFromSelection": "never",

  // --- Files ----------------------------------------------------------------
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "off",
  "files.eol": "\n",

  // --- Search ---------------------------------------------------------------
  "search.smartCase": true,
  "search.useGlobalIgnoreFiles": true,
  "search.useParentIgnoreFiles": true,

  // --- Chrome removal: less to look at, nothing that needs a mouse ----------
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "multiple",
  "breadcrumbs.enabled": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "toggle",
  "workbench.activityBar.location": "default",
  "workbench.statusBar.visible": true,

  // --- Terminal: the closest thing to a tmux pane --------------------------
  // "editor" puts terminals in the editor grid, so they resize, split, and
  // navigate with the same commands as code panes. Change to "view" if you'd
  // rather have the classic bottom panel.
  "terminal.integrated.defaultLocation": "editor",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": false,
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.gpuAcceleration": "on",
  // Let VS Code keybindings win over the shell for these:
  "terminal.integrated.commandsToSkipShell": [
    "workbench.action.toggleMaximizeEditorGroup",
    "workbench.action.navigateLeft",
    "workbench.action.navigateRight",
    "workbench.action.navigateUp",
    "workbench.action.navigateDown"
  ],

  // --- Claude Code ----------------------------------------------------------
  // Graphical panel in the right-hand (secondary) sidebar. Ctrl+Esc toggles
  // focus between editor and Claude — that's your tmux pane-switch equivalent.
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.useTerminal": false,
  "claudeCode.autosave": true,
  "claudeCode.initialPermissionMode": "plan",
  "claudeCode.respectGitIgnore": true,

  // --- Retro-futurist -------------------------------------------------------
  "workbench.colorTheme": "SynthWave '84",
  "editor.fontFamily": "'Monaspace Krypton', 'JetBrains Mono', 'Cascadia Code', Consolas, monospace",
  "terminal.integrated.fontFamily": "'Monaspace Krypton', 'Cascadia Code', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.lineHeight": 1.6,
  "editor.letterSpacing": 0.4,
  // Synthwave '84 glow intensity (0 = off). Run the command
  // "Synthwave '84: Enable Neon Dreams" once to turn the glow on.
  "synthwave84.brightness": 0.45
}
